<Window x:Class="SwiftGet.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:themes="clr-namespace:SwiftGet.App.Themes"
        xmlns:vm="clr-namespace:SwiftGet.App.ViewModels"
        Title="SwiftGet"
        Height="680" Width="1080"
        MinHeight="480" MinWidth="860"
        Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="{DynamicResource AppFont}"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== Header ===== -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="7"
                            Background="{DynamicResource AccentBrush}" Margin="0,0,10,0">
                        <TextBlock Text="S" Foreground="White" FontSize="17" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="SwiftGet" FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="Unduhan segmented paralel" Style="{StaticResource Caption}" />
                    </StackPanel>
                </StackPanel>

                <!-- Ringkasan kecepatan & grafik -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,14,0" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding Downloads.TotalSpeedText}"
                                   FontSize="15" FontWeight="SemiBold"
                                   HorizontalAlignment="Right"
                                   Foreground="{DynamicResource SuccessBrush}" />
                        <TextBlock Text="{Binding Downloads.SummaryText}"
                                   Style="{StaticResource Caption}"
                                   HorizontalAlignment="Right" />
                    </StackPanel>

                    <Border Width="180" Height="40" Background="{DynamicResource SurfaceAltBrush}"
                            CornerRadius="6" Padding="6,4" Margin="0,0,12,0">
                        <themes:SpeedGraph ValuesSource="{Binding Downloads.SpeedHistory}" />
                    </Border>

                    <Button Content="Tema" Style="{StaticResource GhostButton}"
                            Command="{Binding ToggleThemeCommand}" ToolTip="Ganti tema terang/gelap" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Baris tambah URL (paling penting, jadi paling atas) ===== -->
        <Border Grid.Row="1" Padding="20,16,20,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         Style="{StaticResource UrlTextBox}"
                         Text="{Binding NewUrl, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Tempel URL berkas (http/https). Bisa juga menempel dari clipboard.">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding AddCommand}" />
                    </TextBox.InputBindings>
                </TextBox>

                <Button Grid.Column="1" Content="Unduh"
                        Style="{StaticResource PrimaryButton}"
                        Margin="10,0,0,0"
                        Command="{Binding AddCommand}" />

                <Button Grid.Column="2" Content="Tambah ke antrean"
                        Style="{StaticResource GhostButton}"
                        Margin="8,0,0,0"
                        Command="{Binding AddWithoutStartCommand}" />

                <Button Grid.Column="3" Content="Buka folder"
                        Style="{StaticResource GhostButton}"
                        Margin="8,0,0,0"
                        Command="{Binding OpenFolderCommand}"
                        ToolTip="{Binding DownloadDir}" />
            </Grid>
        </Border>

        <!-- ===== Baris aksi massal ===== -->
        <Border Grid.Row="2" Padding="20,4,20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Content="Jeda semua" Style="{StaticResource GhostButton}"
                            Command="{Binding PauseAllCommand}" Margin="0,0,8,0" />
                    <Button Content="Lanjutkan semua" Style="{StaticResource GhostButton}"
                            Command="{Binding ResumeAllCommand}" Margin="0,0,8,0" />
                    <Button Content="Hapus yang selesai" Style="{StaticResource GhostButton}"
                            Command="{Binding ClearCompletedCommand}" />
                </StackPanel>

                <TextBlock Grid.Column="2" Text="{Binding StatusMessage}"
                           Style="{StaticResource Caption}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="480" />
            </Grid>
        </Border>

        <!-- ===== Daftar unduhan ===== -->
        <Border Grid.Row="3" Margin="20,0,20,12"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="8">
            <Grid>
                <DataGrid x:Name="DownloadGrid"
                          ItemsSource="{Binding Downloads.Items}"
                          SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                          Style="{StaticResource DownloadGrid}"
                          ColumnHeaderStyle="{StaticResource GridHeader}"
                          RowStyle="{StaticResource GridRow}"
                          CellStyle="{StaticResource GridCell}"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling">

                    <DataGrid.Columns>
                        <!-- Nama berkas + progress -->
                        <DataGridTemplateColumn Header="Berkas" Width="*" MinWidth="280">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center" Margin="0,6">
                                        <TextBlock Text="{Binding FileName}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding Url}"
                                                   Style="{StaticResource Caption}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,2,0,6" />
                                        <ProgressBar Style="{StaticResource ThinProgressBar}"
                                                     Value="{Binding Fraction, Mode=OneWay, Converter={StaticResource PctConverter}}"
                                                     Maximum="100" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Status -->
                        <DataGridTemplateColumn Header="Status" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StateText}"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{Binding State, Converter={StaticResource StateBrushConverter}}" />
                                        <TextBlock Text="{Binding SegmentText}"
                                                   Style="{StaticResource Caption}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Ukuran -->
                        <DataGridTemplateColumn Header="Ukuran" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SizeText}" Style="{StaticResource Body}" />
                                        <TextBlock Text="{Binding PercentText}" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Kecepatan -->
                        <DataGridTemplateColumn Header="Kecepatan" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SpeedText}" Style="{StaticResource Body}"
                                                   Foreground="{DynamicResource SuccessBrush}" />
                                        <TextBlock Text="{Binding EtaText}" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Aksi baris -->
                        <DataGridTemplateColumn Header="" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Jeda" Style="{StaticResource GhostButton}"
                                                Padding="0" Width="46" Height="26" FontSize="11"
                                                Margin="0,0,6,0"
                                                Command="{Binding DataContext.PauseCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Visibility="{Binding CanPause, Converter={StaticResource BoolToVisibility}}" />
                                        <Button Content="Lanjut" Style="{StaticResource GhostButton}"
                                                Padding="0" Width="52" Height="26" FontSize="11"
                                                Margin="0,0,6,0"
                                                Command="{Binding DataContext.ResumeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Visibility="{Binding CanResume, Converter={StaticResource BoolToVisibility}}" />
                                        <Button Content="Batal" Style="{StaticResource GhostButton}"
                                                Padding="0" Width="46" Height="26" FontSize="11"
                                                Command="{Binding DataContext.CancelCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Empty state -->
                <StackPanel x:Name="EmptyState"
                            VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding Downloads.Items.Count, Converter={StaticResource ZeroToVisible}}">
                    <TextBlock Text="Belum ada unduhan"
                               FontSize="15" FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="Tempel URL di kotak atas, lalu tekan Enter."
                               Margin="0,6,0,0"
                               HorizontalAlignment="Center"
                               Style="{StaticResource Caption}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Status bar ===== -->
        <Border Grid.Row="4" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                Padding="20,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Style="{StaticResource Caption}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis">
                    <Run Text="Folder:" />
                    <Run Text="{Binding DownloadDir, Mode=OneWay}" />
                </TextBlock>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Caption}" Margin="0,0,14,0"
                               VerticalAlignment="Center"
                               Text="{Binding Downloads.SummaryText}" />
                    <Button Content="Pengaturan" Style="{StaticResource GhostButton}"
                            FontSize="11" Padding="10,5"
                            Click="OpenSettings_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
