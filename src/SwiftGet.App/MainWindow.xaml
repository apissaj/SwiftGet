<Window x:Class="SwiftGet.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:themes="clr-namespace:SwiftGet.App.Themes"
        Title="SwiftGet"
        Height="720" Width="1160"
        MinHeight="520" MinWidth="900"
        Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="{StaticResource AppFont}"
        TextOptions.TextFormattingMode="Ideal"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===================== Header ===================== -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Mark: panah unduhan sederhana, digambar sendiri (DESIGN.md bagian 14) -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Viewbox Width="26" Height="26" Margin="0,0,10,0">
                        <Canvas Width="24" Height="24">
                            <Ellipse Width="24" Height="24" Fill="{DynamicResource AccentBrush}" />
                            <Path Stroke="{DynamicResource AccentInkBrush}" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M 12,6 L 12,15 M 8.2,11.6 L 12,15.4 L 15.8,11.6 M 7.5,18 L 16.5,18" />
                        </Canvas>
                    </Viewbox>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="SwiftGet" FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="Unduhan dipecah, diunduh bersamaan"
                                   Style="{StaticResource Caption}" />
                    </StackPanel>
                </StackPanel>

                <!-- Kecepatan total + sparkline: satu pertanyaan, satu grafik (DESIGN.md bagian 9) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0">
                        <TextBlock Text="{Binding Downloads.TotalSpeedText}"
                                   Style="{StaticResource NumericLarge}"
                                   HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding Downloads.SummaryText}"
                                   Style="{StaticResource Caption}"
                                   HorizontalAlignment="Right" />
                    </StackPanel>

                    <Border Width="180" Height="42"
                            Background="{DynamicResource SurfaceAltBrush}"
                            CornerRadius="6" Padding="6,6" Margin="0,0,10,0"
                            ToolTip="Kecepatan total 30 detik terakhir">
                        <themes:SpeedGraph ValuesSource="{Binding Downloads.SpeedHistory}" />
                    </Border>

                    <Button Style="{StaticResource IconButton}"
                            Command="{Binding ToggleThemeCommand}"
                            ToolTip="{Binding ThemeLabel}"
                            AutomationProperties.Name="{Binding ThemeLabel}">
                        <Path x:Name="ThemeGlyph"
                              Width="14" Height="14"
                              Stroke="{DynamicResource TextPrimaryBrush}"
                              StrokeThickness="1.6"
                              Data="M 7,1 A 6,6 0 1 0 7,13 A 4.6,4.6 0 1 1 7,1 Z" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================== Isi ===================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Kolom kiri: input + daftar -->
            <Grid Grid.Column="0" Margin="20,16,20,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Input URL: focal point tunggal layar ini -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="UrlField" Grid.Column="0"
                               Style="{StaticResource UrlTextBox}"
                               Text="{Binding NewUrl, UpdateSourceTrigger=PropertyChanged}"
                               FontFamily="{StaticResource NumericFont}"
                               ToolTip="Tempel URL berkas (http atau https), lalu tekan Enter">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding AddCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>

                    <Button Grid.Column="1" Content="Unduh"
                            Style="{StaticResource PrimaryButton}"
                            Margin="10,0,0,0"
                            MinWidth="92"
                            Command="{Binding AddCommand}" />

                    <Button Grid.Column="2" Content="Ke antrean"
                            Style="{StaticResource GhostButton}"
                            Margin="8,0,0,0"
                            Command="{Binding AddToQueueCommand}" />
                </Grid>

                <!-- Aksi massal -->
                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button Content="Jeda semua" Style="{StaticResource GhostButton}"
                                Command="{Binding PauseAllCommand}" Margin="0,0,8,0" />
                        <Button Content="Lanjutkan semua" Style="{StaticResource GhostButton}"
                                Command="{Binding ResumeAllCommand}" Margin="0,0,8,0" />
                        <Button Content="Hapus yang selesai" Style="{StaticResource GhostButton}"
                                Command="{Binding ClearCompletedCommand}" Margin="0,0,14,0" />

                        <!-- Penyaring: empat kondisi, tidak ada lagi -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                            <RadioButton x:Name="FilterAll" GroupName="DownloadFilter"
                                        Content="Semua" Style="{StaticResource FilterRadio}"
                                        IsChecked="True" Margin="0,0,4,0"
                                        Command="{Binding SetFilterCommand}"
                                        CommandParameter="All" />
                            <RadioButton x:Name="FilterActive" GroupName="DownloadFilter"
                                        Content="Berjalan" Style="{StaticResource FilterRadio}"
                                        Margin="0,0,4,0"
                                        Command="{Binding SetFilterCommand}"
                                        CommandParameter="Active" />
                            <RadioButton x:Name="FilterFailed" GroupName="DownloadFilter"
                                        Content="Gagal" Style="{StaticResource FilterRadio}"
                                        Margin="0,0,4,0"
                                        Command="{Binding SetFilterCommand}"
                                        CommandParameter="Failed" />
                            <RadioButton x:Name="FilterCompleted" GroupName="DownloadFilter"
                                        Content="Selesai" Style="{StaticResource FilterRadio}"
                                        Command="{Binding SetFilterCommand}"
                                        CommandParameter="Completed" />
                        </StackPanel>

                        <!-- Urutan: hanya kolom yang menjawab keputusan pengguna -->
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Urut" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" Margin="0,0,6,0" />
                            <Button x:Name="SortButton" Content="{Binding Downloads.SortLabel}"
                                    Style="{StaticResource GhostButton}" Padding="10,5"
                                    Click="SortButton_Click"
                                    ToolTip="Urutkan daftar" />
                        </StackPanel>

                        <!-- Kategori: dimensi penyaring kedua, satu dropdown -->
                        <StackPanel Orientation="Horizontal" Margin="14,0,0,0">
                            <TextBlock Text="Kategori" Style="{StaticResource Caption}"
                                       VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ComboBox x:Name="CategoryCombo"
                                      Style="{StaticResource CategoryCombo}"
                                      ItemsSource="{Binding Downloads.CategoryOptions}"
                                      SelectedItem="{Binding Downloads.SelectedCategoryOption, Mode=TwoWay}"
                                      Width="140" VerticalAlignment="Center"
                                      ToolTip="Saring berdasarkan jenis berkas" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Grid.Column="2" Text="{Binding StatusMessage}"
                               Style="{StaticResource Caption}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               MaxWidth="520"
                               TextTrimming="None" />
                </Grid>

                <!-- Daftar unduhan -->
                <Border Grid.Row="2"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="10">
                    <Grid>
                        <ListBox ItemsSource="{Binding Downloads.VisibleItems}"
                                 SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                 Style="{StaticResource DownloadList}"
                                 MinHeight="160">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="16,12">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- ===== Baris utama ===== -->
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding FileName}"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Host}"
                                                           Style="{StaticResource Caption}"
                                                           Margin="0,2,0,0" />
                                            </StackPanel>

                                            <!-- Status + aksi -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding StateText}"
                                                               FontSize="11" FontWeight="SemiBold"
                                                               HorizontalAlignment="Right"
                                                               Foreground="{Binding State, Converter={StaticResource StateBrushConverter}}" />
                                                    <TextBlock Text="{Binding SegmentText}"
                                                               Style="{StaticResource Caption}"
                                                               HorizontalAlignment="Right" />
                                                </StackPanel>

                                                <Button Content="Jeda" Style="{StaticResource GhostButton}"
                                                        Padding="10,5" FontSize="11" Margin="0,0,6,0"
                                                        Command="{Binding DataContext.PauseCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        Visibility="{Binding CanPause, Converter={StaticResource BoolToVisibility}}" />
                                                <Button Content="Lanjut" Style="{StaticResource GhostButton}"
                                                        Padding="10,5" FontSize="11" Margin="0,0,6,0"
                                                        Command="{Binding DataContext.ResumeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        Visibility="{Binding CanResume, Converter={StaticResource BoolToVisibility}}" />
                                                <Button Content="Batal" Style="{StaticResource GhostButton}"
                                                        Padding="10,5" FontSize="11"
                                                        Command="{Binding DataContext.CancelCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisibility}}" />
                                            </StackPanel>
                                        </Grid>

                                        <!-- ===== Mode penuh: angka + rel progres ===== -->
                                        <Grid Grid.Row="1" Margin="0,10,0,0"
                                              Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibility}}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0" Margin="0,0,0,7">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{Binding SizeText}"
                                                           Style="{StaticResource Numeric}"
                                                           Margin="0,0,16,0" />
                                                <TextBlock Grid.Column="1" Text="{Binding SpeedText}"
                                                           Style="{StaticResource Numeric}"
                                                           Foreground="{DynamicResource SuccessBrush}"
                                                           Margin="0,0,16,0" />
                                                <TextBlock Grid.Column="2" Text="{Binding EtaText}"
                                                           Style="{StaticResource Numeric}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           Margin="0,0,16,0" />
                                                <TextBlock Grid.Column="4" Text="{Binding PercentText}"
                                                           Style="{StaticResource Numeric}"
                                                           FontWeight="SemiBold" />
                                            </Grid>

                                            <ProgressBar Grid.Row="1"
                                                         Style="{StaticResource ThinProgressBar}"
                                                         Value="{Binding ProgressPercent, Mode=OneWay}"
                                                         Maximum="100" />
                                        </Grid>

                                        <!-- ===== Mode ringkas: ukuran + aksi ringan ===== -->
                                        <Grid Grid.Row="1" Margin="0,8,0,0"
                                              Visibility="{Binding IsCompact, Converter={StaticResource BoolToVisibility}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding TotalSizeText}"
                                                       Style="{StaticResource Numeric}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />

                                            <Button Grid.Column="1" Content="Buka lokasi"
                                                    Style="{StaticResource GhostButton}"
                                                    Padding="10,5" FontSize="11"
                                                    Command="{Binding DataContext.OpenFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Visibility="{Binding CanOpenFile, Converter={StaticResource BoolToVisibility}}" />
                                        </Grid>

                                        <!-- Galat: pesan apa adanya, tidak disembunyikan -->
                                        <Border Grid.Row="1" Margin="0,10,0,0"
                                                Background="{DynamicResource SurfaceAltBrush}"
                                                CornerRadius="6" Padding="10,7"
                                                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="{Binding Error}"
                                                       Style="{StaticResource Caption}"
                                                       Foreground="{DynamicResource DangerBrush}"
                                                       TextWrapping="Wrap" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Keadaan kosong: belum ada unduhan -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="{Binding Downloads.IsEmpty, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Belum ada unduhan"
                                       FontSize="14" FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Tempel URL berkas di kotak atas, lalu tekan Enter."
                                       Margin="0,6,0,0" HorizontalAlignment="Center"
                                       Style="{StaticResource Caption}" />
                            <Button Content="Ke kotak URL" Style="{StaticResource GhostButton}"
                                    Margin="0,14,0,0" HorizontalAlignment="Center"
                                    Command="{Binding FocusUrlCommand}" />
                        </StackPanel>

                        <!-- Keadaan kosong: penyaring tidak menghasilkan apa pun -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="{Binding Downloads.IsFilteredEmpty, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="Tidak ada yang cocok"
                                       FontSize="14" FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Tidak ada unduhan pada penyaring ini."
                                       Margin="0,6,0,0" HorizontalAlignment="Center"
                                       Style="{StaticResource Caption}" />
                            <Button Content="Tampilkan semua" Style="{StaticResource GhostButton}"
                                    Margin="0,14,0,0" HorizontalAlignment="Center"
                                    Command="{Binding ClearFilterCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Kolom kanan: panel periksa -->
            <Border x:Name="InspectorScrim"
                    Grid.Column="0" Grid.ColumnSpan="2"
                    Background="#33000000"
                    Visibility="Collapsed"
                    MouseLeftButtonDown="InspectorScrim_Click" />

            <Border x:Name="InspectorPanel"
                    Grid.Column="1"
                    Width="304"
                    Margin="0,16,20,12"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="10"
                    Visibility="{Binding IsInspectorOpen, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Judul panel -->
                    <Grid Grid.Row="0" Margin="16,14,12,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Periksa unduhan" Style="{StaticResource SectionLabel}" />
                            <TextBlock Text="{Binding SelectedItem.FileName}"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,3,0,0" />
                        </StackPanel>

                        <Button Grid.Column="1" Style="{StaticResource IconButton}"
                                Width="28" Height="28"
                                Command="{Binding CloseInspectorCommand}"
                                ToolTip="Tutup panel"
                                AutomationProperties.Name="Tutup panel">
                            <Path Width="10" Height="10" Stroke="{DynamicResource TextPrimaryBrush}"
                                  StrokeThickness="1.6"
                                  Data="M 1,1 L 9,9 M 9,1 L 1,9" />
                        </Button>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,0,12,0">
                        <StackPanel>
                            <!-- Peta segmen: bagian mana yang tertinggal -->
                            <TextBlock Text="Bagian unduhan" Style="{StaticResource SectionLabel}" />
                            <TextBlock Text="{Binding SelectedItem.SegmentText}"
                                       Style="{StaticResource Caption}" Margin="0,2,0,8" />
                            <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="10">
                                <StackPanel>
                                    <themes:SegmentMap Height="26"
                                                       SegmentsSource="{Binding SelectedItem.Segments}"
                                                       AutomationProperties.Name="Peta bagian unduhan" />
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Border Width="8" Height="8" CornerRadius="2"
                                                Background="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="Selesai" Style="{StaticResource Caption}" Margin="6,0,14,0" />
                                        <Border Width="8" Height="8" CornerRadius="2"
                                                Background="{DynamicResource WarningBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="Berjalan" Style="{StaticResource Caption}" Margin="6,0,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Kecepatan unduhan ini -->
                            <TextBlock Text="Kecepatan 30 detik" Style="{StaticResource SectionLabel}" Margin="0,16,0,6" />
                            <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="8" Padding="8" Height="64">
                                <themes:SpeedGraph ValuesSource="{Binding SelectedItem.SpeedHistory}" />
                            </Border>

                            <!-- Ringkasan kunci-nilai -->
                            <TextBlock Text="Rincian" Style="{StaticResource SectionLabel}" Margin="0,16,0,6" />
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Kategori" Style="{StaticResource Caption}" />
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedItem.CategoryText}"
                                               Style="{StaticResource Caption}" />
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Ukuran" Style="{StaticResource Caption}" />
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedItem.TotalSizeText}"
                                               Style="{StaticResource Numeric}" TextTrimming="CharacterEllipsis" />
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Koneksi" Style="{StaticResource Caption}" />
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedItem.ConnectionText}"
                                               Style="{StaticResource Numeric}" />
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Dukungan Range" Style="{StaticResource Caption}" />
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedItem.RangeSupportText}"
                                               Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Validator" Style="{StaticResource Caption}" />
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedItem.ValidatorText}"
                                               Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Folder" Style="{StaticResource Caption}" />
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedItem.TargetFolder}"
                                               Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="URL" Style="{StaticResource Caption}" />
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedItem.Url}"
                                               Style="{StaticResource Caption}" TextWrapping="Wrap" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Aksi panel -->
                    <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0"
                            Padding="16,12">
                        <StackPanel>
                            <Button Content="Salin URL" Style="{StaticResource GhostButton}"
                                    HorizontalAlignment="Stretch" Margin="0,0,0,6"
                                    Command="{Binding CopyUrlCommand}" />
                            <Button Content="Buka lokasi" Style="{StaticResource GhostButton}"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding OpenFileCommand}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ===================== Status bar ===================== -->
        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Folder" Style="{StaticResource Caption}" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding DownloadDir}"
                               Style="{StaticResource Caption}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Buka folder" Style="{StaticResource GhostButton}"
                            FontSize="11" Padding="10,5" Margin="0,0,8,0"
                            Command="{Binding OpenFolderCommand}" />
                    <Button Content="Riwayat" Style="{StaticResource GhostButton}"
                            FontSize="11" Padding="10,5" Margin="0,0,8,0"
                            Click="OpenHistory_Click" />
                    <Button Content="Pengaturan" Style="{StaticResource GhostButton}"
                            FontSize="11" Padding="10,5"
                            Click="OpenSettings_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>



