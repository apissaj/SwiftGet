<Window x:Class="SwiftGet.App.YouTubeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pilih kualitas YouTube"
        Height="440" Width="520"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="{DynamicResource AppFont}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="YouTube" Style="{StaticResource Heading}" />
            <TextBlock x:Name="JudulText" Style="{StaticResource Caption}" Margin="0,4,0,0"
                       TextWrapping="Wrap" />
        </StackPanel>

        <TextBlock Grid.Row="1" Text="Pilih kualitas video (audio diunduh &amp; digabung otomatis):"
                   Style="{StaticResource Caption}" Margin="0,0,0,8" />

        <ListBox x:Name="DaftarFormat" Grid.Row="2"
                 Style="{StaticResource DownloadList}"
                 BorderThickness="1" MinHeight="120">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Label}" Margin="4,6" TextWrapping="Wrap" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Batal" Style="{StaticResource GhostButton}"
                    Margin="0,0,8,0" Click="Batal_Click" />
            <Button Content="Unduh" Style="{StaticResource PrimaryButton}" Click="Unduh_Click" />
        </StackPanel>
    </Grid>
</Window>
