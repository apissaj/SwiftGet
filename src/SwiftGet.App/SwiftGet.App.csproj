<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>SwiftGet</AssemblyName>
    <RootNamespace>SwiftGet.App</RootNamespace>
    

    <!-- Ukuran & startup: matikan fitur yang tidak dipakai. -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <DebugType>embedded</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!-- Informasi produk -->
    <Product>SwiftGet</Product>
    <AssemblyTitle>SwiftGet</AssemblyTitle>
    <Description>Download manager ringan dengan unduhan segmented paralel dan resume.</Description>
    <Version>0.1.0</Version>
    <FileVersion>0.1.0.0</FileVersion>
    <Company>SwiftGet</Company>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SwiftGet.Core\SwiftGet.Core.csproj" />
  </ItemGroup>

</Project>

