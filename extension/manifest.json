{
  "manifest_version": 3,
  "name": "SwiftGet",
  "description": "Tangkap unduhan, video, dan gambar dari halaman; kirim ke aplikasi SwiftGet.",
  "version": "1.2.0",
  "author": "apissaj",
  "homepage_url": "https://github.com/apissaj/SwiftGet",

  "permissions": ["cookies", "storage"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "http://*/*",
    "https://*/*"
  ],

  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" },
    "default_title": "SwiftGet"
  },

  "background": { "service_worker": "background.js" },

  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "css": ["panel.css"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["sites.json"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],

  "options_page": "options.html"
}
